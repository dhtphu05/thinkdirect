# ThinkDirect — DevFest 2026 Environment Configuration
# Copy this file to `.env.local` and paste your Google AI Studio Gemini API Key.
# Without a key, ThinkDirect automatically runs in Video-Ready Guided Happy Path mode.

GEMINI_API_KEY=

# Optional model overrides (defaults shown below)
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_STT_MODEL=gemini-2.5-flash
GEMINI_COACH_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
PORT=3000
